# Общие настройки
APP_VERSION=1.0.0
NODE_ENV=production

# Настройки для Next.js
PORT=3028

# Бекенд переменные (через nginx)
#NEXT_PUBLIC_API_URL=https://api-d.compasstransfer.kg
NEXT_PUBLIC_API_URL=https://api-d.compasstransfer.kg
#NEXT_PUBLIC_DOMAIN=.d.compasstransfer.kg
NEXT_PUBLIC_DOMAIN=.d.compasstransfer.kg

# Название куки для аутентификации
AUTH_COOKIE_NAME=.AspNetCore.Identity.Application

# Настройки для WebSocket (через nginx)
#NEXT_PUBLIC_WS_BASE_URL=wss://api.d.compasstransfer.kg/hubs/wshub
NEXT_PUBLIC_WS_BASE_URL=wss://api-d.compasstransfer.kg/hubs/wshub