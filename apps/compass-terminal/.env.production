# Общие настройки
APP_VERSION=1.0.0
NODE_ENV=production

# Настройки для Next.js
PORT=3029

# Бекенд переменные (через nginx)
#NEXT_PUBLIC_API_URL=https://api.compasstransfer.kg
NEXT_PUBLIC_API_URL=https://poc-api.compasstransfer.kg
#NEXT_PUBLIC_DOMAIN=.terminal.compasstransfer.kg
NEXT_PUBLIC_DOMAIN=.poc.terminal.compasstransfer.kg

# Название куки для аутентификации
AUTH_COOKIE_NAME=.AspNetCore.Identity.Application

# Настройки для WebSocket (через nginx)
#NEXT_PUBLIC_WS_BASE_URL=wss://api.compasstransfer.kg/hubs/wshub
NEXT_PUBLIC_WS_BASE_URL=wss://poc-api.compasstransfer.kg/hubs/wshub

# Fiscl check NewCase
NEXT_PUBLIC_USE_FISCAL=true